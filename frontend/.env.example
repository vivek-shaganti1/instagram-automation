# Supabase (Project Settings → API). Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Lets /api routes read the settings/generated_posts tables even
# with RLS enabled. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: URL of the deployed Express worker (backend/). When set, /api/*
# is proxied there so Post Now / Sync Insights work. Leave empty otherwise.
BACKEND_URL=
